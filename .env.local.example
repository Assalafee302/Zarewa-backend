# Copy to `.env.local` (gitignored) for local development on your PC.
# Keep production values in `.env` / hPanel; override only what differs locally.

NODE_ENV=development
COOKIE_SECURE=0
ZAREWA_ALLOW_LOCAL_SPA_CORS=1

# Hostinger MySQL from your dev PC (same credentials as `.env`; do not use while Hostinger API is migrating).
# ZAREWA_MYSQL_HOST=srv2078.hstgr.io
# ZAREWA_MYSQL_SYNC_TIMEOUT_MS=300000
# ZAREWA_MIGRATION_LOCK_WAIT_SEC=180

# Optional: frontend repo when not at ../Zarewa-frontend-main
# ZAREWA_FRONTEND_ROOT=../Zarewa-frontend-main
